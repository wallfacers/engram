# Local agent credentials / settings (per spec-kit security note)
.claude/settings.local.json
.claude/**/*.local.json

# Parallel-feature git worktrees (separate checkouts, never part of this tree)
.claude/worktrees/

# Go build artifacts
/bin/
*.exe
*.test
*.out
coverage.*
!coverage.go
!coverage_test.go
cmd/locomo-bench/locomo-bench
/locomo-bench

# Python bytecode (eval/analysis scripts under scripts/)
__pycache__/
*.pyc

# SQLite stores / local data
*.db
*.db-shm
*.db-wal
*.sqlite
/data/
testdata/parity/cache/

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.tmp
.vscode/
.idea/

# LoCoMo dataset (public, not redistributed via repo)
/testdata/locomo/
/.locomo-run/

# LongMemEval dataset (public, not redistributed via repo). sample.json is a
# hand-written schema fixture and stays tracked.
/testdata/longmemeval/longmemeval_*.json
/.longmemeval-run/
pcic_meta*.json
cov-pcic*
ans-pcic*

# eval notebook (per-run mistake attribution; contains raw conversation text)
/eval-notebook/
