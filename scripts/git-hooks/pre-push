#!/bin/sh
# Guard: every change goes through a pull request. Never push straight to the
# default branch. Enable once per clone with:
#   git config core.hooksPath scripts/git-hooks
#
# git calls this hook as: pre-push <remote> <remote-url>, and feeds one line per
# ref to update on stdin:
#   <local ref> <local oid> <remote ref> <remote oid>
# A local ref of "(delete)" means the remote ref is being deleted.

remote="$1"
blocked=0

while read -r local_ref local_oid remote_ref remote_oid; do
	[ "$local_ref" = "(delete)" ] && continue
	case "$remote_ref" in
		refs/heads/main | refs/heads/master | main | master)
			blocked=1
			printf '  blocked: %s -> %s (%s)\n' "$local_ref" "$remote_ref" "$remote" >&2
			;;
	esac
done

if [ "$blocked" -eq 1 ]; then
	cat >&2 <<'MSG'

pre-push: refusing to push to the default branch.

Every change goes through a pull request, including one-line doc, CI, and
config fixes. Put the work on a branch and open a PR instead:

  git switch -c codex/<short-topic>
  git push origin codex/<short-topic>      # then open the PR

Merge the PR once it is green and reviewed. Do not work around this hook by
pushing to main/master, and do not disable it for a "quick" change.
MSG
	exit 1
fi

exit 0
