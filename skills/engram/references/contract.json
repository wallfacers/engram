{
  "schema_version": 1,
  "skill": {
    "name": "engram",
    "version": "0.2.1"
  },
  "triggers": {
    "explicit": "user wording asks for a memory operation",
    "implicit_write": "ordinary conversation reveals a durable fact (stable preference, constraint, identity, project convention, long-term decision/state change, or a complaint revealing a standing rule) — write once in the same turn and acknowledge",
    "implicit_read": "question or task depends on remembered facts — 'which/what/when + my/our/usual/previous' question forms, plans needing a standing constraint, or actions (install/build/run) a remembered convention could govern — search before answering or acting; query constraint vocabulary in 2-4 short terms; report empty results honestly",
    "never": ["transient task context", "RAM/cache/database near-misses", "secrets", "facts the user declined to store", "third-party facts misattributed to the user"]
  },
  "mcp": {
    "always": [
      "memory_delete",
      "memory_evidence_get",
      "memory_evidence_purge",
      "memory_evidence_restore",
      "memory_evidence_tombstone",
      "memory_get",
      "memory_ingest_v2",
      "memory_list",
      "memory_search",
      "memory_write"
    ],
    "conditional": {
      "memory_ingest": "llm"
    }
  },
  "cli": {
    "commands": [
      "add",
      "curate",
      "delete",
      "export",
      "get",
      "ingest",
      "list",
      "namespaces",
      "search",
      "stats",
      "version"
    ]
  },
  "intents": [
    {
      "name": "write",
      "mutating": true,
      "mcp": "memory_write",
      "cli": "add",
      "condition": "explicit user intent or implicit durable-fact disclosure"
    },
    {
      "name": "search",
      "mutating": false,
      "mcp": "memory_search",
      "cli": "search",
      "condition": "memory-dependent question or task (implicit read)"
    },
    {
      "name": "get",
      "mutating": false,
      "mcp": "memory_get",
      "cli": "get",
      "condition": null
    },
    {
      "name": "list",
      "mutating": false,
      "mcp": "memory_list",
      "cli": "list",
      "condition": null
    },
    {
      "name": "delete",
      "mutating": true,
      "mcp": "memory_delete",
      "cli": "delete",
      "condition": "explicit user intent"
    },
    {
      "name": "ingest",
      "mutating": true,
      "mcp": "memory_ingest_v2",
      "cli": "ingest",
      "condition": "explicit intent + stable session and source IDs"
    },
    {
      "name": "curate",
      "mutating": true,
      "mcp": null,
      "cli": "curate",
      "condition": "explicit intent + LLM"
    },
    {
      "name": "stats",
      "mutating": false,
      "mcp": null,
      "cli": "stats",
      "condition": "CLI store identity confirmed"
    },
    {
      "name": "export",
      "mutating": false,
      "mcp": null,
      "cli": "export",
      "condition": "CLI store identity confirmed"
    },
    {
      "name": "namespace-discovery",
      "mutating": false,
      "mcp": null,
      "cli": "namespaces",
      "condition": "CLI data dir confirmed"
    },
    {
      "name": "version",
      "mutating": false,
      "mcp": null,
      "cli": "version",
      "condition": null
    }
  ]
}
